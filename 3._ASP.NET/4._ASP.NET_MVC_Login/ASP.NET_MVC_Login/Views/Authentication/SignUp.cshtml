@using ASP.NET_MVC_Login.Models.ViewModels
@model SignUpViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<div class="signup-container">
    <div class="signup-title">
        <h2>Sign Up</h2>

        <form asp-action="SignUp" method="post" asp-antiforgery="true">

            <div class="form-group">

                <label asp-for="Username"></label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label asp-for="ConfirmPassord"></label>
                <input asp-for="ConfirmPassord" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassord" class="text-danger"></span>

            </div>

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <button type="submit" class="btn btn-primary btn-block">Register</button>

            <div class="mt-3 text-center">

                <p>

                    ¿Ya tienes una cuenta?
                    <a asp-controller="Authentication" asp-action="Login" class="btn btn-secondary ml-2">Iniciar Sesión</a>

                </p>

            </div>

        </form>

    </div>
</div>


